generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Explicit, so the output doesn't depend on whether a tsconfig.json is present when
  // generating (the Docker build generates before copying it).
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum LeadTier {
  hot
  warm
  cold
  disqualified
}

enum LeadStatus {
  new
  contacted
  engaged
  qualified
  disqualified
  converted
  unresponsive
  do_not_contact
}

enum Channel {
  email
  whatsapp
  sms
}

enum LeadEventType {
  captured
  scored
  message_sent
  message_failed
  reply_received
  opted_out
  enrolled
  sequence_stopped
  sequence_completed
  status_changed
  crm_synced
  crm_sync_failed
  rep_notified
  sequence_paused
  sequence_resumed
}

enum ConsentPurpose {
  email
  messaging
}

enum EnrollmentStatus {
  active
  // Paused by an operator: no steps run until it's resumed. Replies and opt-outs still stop it.
  paused
  stopped
  completed
}

model Lead {
  id         String     @id @default(uuid())
  firstName  String?
  lastName   String?
  email      String?
  phone      String? // E.164
  company    String?
  source     String // e.g. "website", "typeform"
  utm        Json? // first-touch UTM params
  fields     Json? // normalized form answers keyed by field name (input for scoring)
  rawPayload Json // first submission as received
  score      Int?
  tier       LeadTier?
  status     LeadStatus @default(new)
  crmId      String?

  // CRM sync cursor: the last event pushed to the CRM (events are append-only, so progress
  // lives here). Ordered by (createdAt, id).
  crmSyncedThrough DateTime?
  crmSyncedEventId String?
  // Set when a sync is dead-lettered; the sweep skips the lead until it's requeued.
  crmSyncFailedAt  DateTime?
  crmSyncError     String?
  timezone         String?

  consentEmail     Boolean @default(false)
  consentMessaging Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events      LeadEvent[]
  enrollments Enrollment[]
  consents    ConsentRecord[]

  @@index([email])
  @@index([phone])
  @@index([status])
}

// Append-only audit trail; also the source for CRM activity sync.
model LeadEvent {
  id        String        @id @default(uuid())
  leadId    String
  lead      Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      LeadEventType
  channel   Channel?
  payload   Json?
  // Idempotency key for events caused by inbound webhooks, e.g. "typeform:<response token>".
  dedupeKey String?       @unique
  createdAt DateTime      @default(now())

  @@index([leadId, createdAt])
  @@index([type, createdAt])
}

model Sequence {
  id               String         @id @default(uuid())
  name             String         @unique
  tier             LeadTier
  active           Boolean        @default(true)
  // After the last step, how long to wait for a reply before marking the lead unresponsive.
  finalWaitMinutes Int            @default(4320)
  steps            SequenceStep[]
  enrollments      Enrollment[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model SequenceStep {
  id            String   @id @default(uuid())
  sequenceId    String
  sequence      Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order         Int
  offsetMinutes Int // when the step runs, in minutes after enrollment (the first contact)
  channel       Channel
  templateId    String
  template      Template @relation(fields: [templateId], references: [id])

  @@unique([sequenceId, order])
}

model Enrollment {
  id          String           @id @default(uuid())
  leadId      String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sequenceId  String
  sequence    Sequence         @relation(fields: [sequenceId], references: [id])
  // `order` of the next step to run; past the last step while waiting to complete.
  currentStep Int              @default(0)
  status      EnrollmentStatus @default(active)
  // When the next step (or the completion check) is due; the source of truth for the schedule.
  nextRunAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, nextRunAt])
  @@index([leadId])
}

model Template {
  id        String         @id @default(uuid())
  name      String         @unique
  channel   Channel
  subject   String? // email only
  body      String // supports {{variable}} and {{variable|fallback}}
  // WhatsApp only: language of the approved template, e.g. "en_US" or "pt_BR". `name` must
  // match the template name approved in Meta, and `body` its text (parameters in order).
  locale    String?
  steps     SequenceStep[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

// Consent ledger (LGPD/GDPR evidence): every grant and withdrawal, append-only. The Lead's
// consent flags are the current state; these rows show when, where and how it was given.
model ConsentRecord {
  id        String         @id @default(uuid())
  leadId    String
  lead      Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  purpose   ConsentPurpose
  granted   Boolean
  // Where it came from: the form source ("website", "typeform"), "reply", "unsubscribe_link"…
  source    String
  // What was shown and captured, e.g. consent text/version, form and response ids, submittedAt.
  evidence  Json?
  createdAt DateTime       @default(now())

  @@index([leadId, createdAt])
}

// Addresses that must never be contacted again, kept after their lead is erased (so a new
// form submission can't restart contact). Only hashes: sha256 of "email:<address>" or
// "phone:<E.164>".
model Suppression {
  hash      String   @id
  reason    String // "erasure_request" | "opted_out"
  createdAt DateTime @default(now())
}

// Audit log of erasures. Holds no personal data: subjects are the suppression hashes.
model Erasure {
  id            String   @id @default(uuid())
  reason        String // "request" | "retention"
  leadCount     Int
  crmDeleted    Int      @default(0)
  subjectHashes String[]
  createdAt     DateTime @default(now())

  @@index([createdAt])
}
