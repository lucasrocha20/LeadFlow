{
  "name": "leadflow",
  "version": "0.1.0",
  "private": true,
  "description": "Lead follow-up automation: capture, qualification, contact, follow-up and CRM sync",
  "license": "MIT",
  "author": "Lucas Rocha",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node --env-file=.env node_modules/vitest/vitest.mjs run --no-file-parallelism test/db",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "crm:requeue": "tsx --env-file-if-exists=.env scripts/crm-requeue.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasrocha20/LeadFlow.git"
  },
  "bugs": {
    "url": "https://github.com/lucasrocha20/LeadFlow/issues"
  },
  "homepage": "https://github.com/lucasrocha20/LeadFlow#readme",
  "dependencies": {
    "@bull-board/api": "^9.10.1",
    "@bull-board/fastify": "^9.10.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.3.8",
    "dotenv": "^18.0.3",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "libphonenumber-js": "^1.13.13",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.8",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true
  }
}
