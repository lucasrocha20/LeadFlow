{
  "quietHours": {
    "start": "21:00",
    "end": "08:00",
    "channels": ["whatsapp", "sms"],
    "defaultTimezone": "America/Sao_Paulo"
  },
  "tiers": {
    "hot": {
      "messages": [
        {
          "channel": "whatsapp",
          "template": "first_contact_whatsapp"
        },
        {
          "channel": "email",
          "template": "first_contact_email"
        }
      ],
      "repAlertTemplate": "rep_alert_hot_lead",
      "followUpSequence": "hot_follow_up"
    },
    "warm": {
      "messages": [
        {
          "channel": "email",
          "template": "first_contact_email"
        },
        {
          "channel": "whatsapp",
          "template": "first_contact_whatsapp"
        }
      ],
      "followUpSequence": "warm_follow_up"
    },
    "cold": {
      "messages": [
        {
          "channel": "email",
          "template": "first_contact_email"
        }
      ],
      "followUpSequence": "cold_follow_up"
    }
  },
  "replies": {
    "optOutKeywords": [
      "STOP",
      "UNSUBSCRIBE",
      "CANCEL",
      "END",
      "QUIT",
      "SAIR",
      "PARAR",
      "CANCELAR",
      "DESCADASTRAR"
    ],
    "repAlertTemplate": "rep_alert_reply"
  }
}
