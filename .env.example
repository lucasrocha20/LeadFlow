# --- App ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Infrastructure (matches docker-compose.yml) ---
# Host ports used by docker compose; change them if 5432/6379 are taken.
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://leadflow:leadflow@localhost:5432/leadflow
REDIS_URL=redis://localhost:6379

# --- Form providers (Phase 1) ---
# A provider's webhook is only enabled when its secret is set.
# Website form: callers send the secret in the X-Webhook-Secret header.
FORM_WEBHOOK_SECRET=
# Typeform: the secret configured on the webhook (verifies Typeform-Signature).
TYPEFORM_WEBHOOK_SECRET=
# Region used to parse phone numbers submitted without a country code (ISO 3166-1 alpha-2).
DEFAULT_PHONE_COUNTRY=BR

# --- Messaging: WhatsApp Cloud API or Twilio (Phase 3) ---
MESSAGING_PROVIDER=dry-run
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email: Resend or SendGrid (Phase 3) ---
EMAIL_PROVIDER=dry-run
EMAIL_FROM=
RESEND_API_KEY=
SENDGRID_API_KEY=

# --- CRM: HubSpot or Pipedrive (Phase 5) ---
CRM_PROVIDER=dry-run
HUBSPOT_ACCESS_TOKEN=
PIPEDRIVE_API_TOKEN=
