# --- App ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Infrastructure (matches docker-compose.yml) ---
# Host ports used by docker compose; change them if 5432/6379 are taken.
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://leadflow:leadflow@localhost:5432/leadflow
REDIS_URL=redis://localhost:6379

# --- HTTP ---
# Behind a load balancer: "true", a hop count, or the proxies' IPs/CIDRs (see src/config.ts).
TRUST_PROXY=
# Per client IP, on every route but /health; 0 disables.
RATE_LIMIT_PER_MINUTE=300

# --- Form providers (Phase 1) ---
# A provider's webhook is only enabled when its secret is set.
# Website form: callers send the secret in the X-Webhook-Secret header.
FORM_WEBHOOK_SECRET=
# Typeform: the secret configured on the webhook (verifies Typeform-Signature).
TYPEFORM_WEBHOOK_SECRET=
# Region used to parse phone numbers submitted without a country code (ISO 3166-1 alpha-2).
DEFAULT_PHONE_COUNTRY=BR

# --- Qualification (Phase 2) ---
# Scoring rules, tier thresholds and disqualifiers (JSON, relative to the working directory).
SCORING_RULES_PATH=config/scoring.json

# --- First contact (Phase 3) ---
# Channel strategy per tier and quiet hours (JSON, relative to the working directory).
CONTACT_CONFIG_PATH=config/contact.json
# Receives an alert for every hot lead; leave empty to skip alerts.
SALES_ALERT_EMAIL=

# --- Messaging: dry-run | whatsapp (WhatsApp Cloud API) ---
# dry-run logs messages instead of sending them.
MESSAGING_PROVIDER=dry-run
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Inbound replies (Phase 4): App Secret (signs webhook calls) and the verify token you set in Meta.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Twilio (not implemented yet)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email: dry-run | resend ---
EMAIL_PROVIDER=dry-run
# Sender, e.g. "Acme Sales <sales@acme.com>" (required for resend)
EMAIL_FROM=
RESEND_API_KEY=
# SendGrid (not implemented yet)
SENDGRID_API_KEY=

# --- Follow-up (Phase 4) ---
# Inbound email replies: POST /webhooks/replies/email with this secret in X-Webhook-Secret.
REPLY_WEBHOOK_SECRET=
# Unsubscribe links in emails ({{unsubscribeUrl}}); set both or neither.
PUBLIC_BASE_URL=
UNSUBSCRIBE_SECRET=

# --- CRM (Phase 5): dry-run | hubspot ---
CRM_PROVIDER=dry-run
# Stage mapping, owners and CRM -> LeadFlow rules (JSON, relative to the working directory).
CRM_CONFIG_PATH=config/crm.json
# HubSpot private app token (scopes: crm.objects.contacts.read, crm.objects.contacts.write).
HUBSPOT_ACCESS_TOKEN=
# HubSpot app client secret: enables POST /webhooks/crm/hubspot (also needs PUBLIC_BASE_URL).
HUBSPOT_CLIENT_SECRET=
# Pipedrive (not implemented yet)
PIPEDRIVE_API_TOKEN=

# --- Privacy (Phase 7) ---
# Erase leads inactive for this many days (min 30); unset keeps them. E.g. 730 for two years.
DATA_RETENTION_DAYS=

# --- Operations (Phase 6) ---
# Enables the admin API (/admin/api) and queue UI (/admin/queues). At least 24 characters.
ADMIN_TOKEN=
# Slack-compatible incoming webhook for alerts; alerts are only logged when unset.
ALERT_WEBHOOK_URL=
ALERT_QUEUE_BACKLOG=500
ALERT_QUEUE_WAIT_MINUTES=15
ALERT_SEND_FAILURES=5
ALERT_WINDOW_MINUTES=15
ALERT_COOLDOWN_MINUTES=60
